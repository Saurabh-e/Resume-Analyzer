# Server Configuration
NODE_ENV=production
PORT=5000

# MongoDB Configuration (MongoDB Atlas Connection String)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ai-resume-analyzer?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-production-jwt-secret-at-least-32-chars
JWT_EXPIRE=7d

# Groq API Configuration (for AI Analysis)
GROQ_API_KEY=gsk_your_groq_api_key_here

# File Upload Configuration (5MB default)
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# CORS Configuration (Vercel Frontend URL)
CLIENT_URL=https://your-frontend-app.vercel.app
FRONTEND_URL=https://your-frontend-app.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
